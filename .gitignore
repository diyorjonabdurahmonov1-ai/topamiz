# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# user-uploaded content (saved to disk by the /api/upload route)
/.uploads/
# resized copies of uploads, regenerated on demand (see src/lib/images.ts)
/.cache/

# local SQLite database
/.data/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android (TWA) — build output, and signing keys, which must never be committed
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
*.jks
*.keystore
